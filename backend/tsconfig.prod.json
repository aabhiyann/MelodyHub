{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "strict": false,
        "noImplicitAny": false,
        "noUncheckedIndexedAccess": false,
        "skipLibCheck": true,
        "noEmitOnError": false
    },
    "exclude": [
        "node_modules",
        "**/*.test.ts",
        "**/__tests__/**",
        "src/__tests__",
        "src/tests/**"
    ]
}